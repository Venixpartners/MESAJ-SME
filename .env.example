# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (Project Settings -> API -> service_role) — server-only,
# never expose with a NEXT_PUBLIC_ prefix. Used to upload/read the private
# `cac-documents` Storage bucket (see src/lib/supabase/admin.ts). This
# bucket is created by the sender_id_cac_document migration; nothing else
# needs manual setup in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# Database (Supabase connection string, used by Prisma)
# MUST be the Transaction pooler URI (Project Settings -> Database ->
# Connection string -> "Transaction" tab), port 6543, with
# ?pgbouncer=true — NOT the Session pooler (5432) and NOT the direct
# connection string. This app runs as Vercel serverless functions:
# every concurrent request can spin up a separate instance, each with
# its own Postgres connection(s), and Session mode's low connection
# ceiling (pool_size ~15) gets exhausted almost immediately under any
# real concurrency (EMAXCONNSESSION / "max clients reached in session
# mode"). Transaction mode is built for exactly this many-short-lived-
# connections pattern. See src/lib/prisma.ts for the matching pool cap.
DATABASE_URL=

# Direct (non-pooled) connection string, port 5432 — used only for
# `prisma migrate deploy` / CI migration jobs, never by the running app.
# PgBouncer transaction mode can interfere with some DDL/migration
# behavior, so migrations should bypass the pooler entirely. Optional
# for local dev (falls back to DATABASE_URL if unset); set explicitly
# in Vercel/CI once migrations run against a pooled DATABASE_URL.
DIRECT_URL=

# Mesaj client API
MESAJ_API_BASE_URL=https://api.mesaj.cloud:25274
MESAJ_API_TOKEN=

# Mesaj SME's OWN carrier-approved shortCode (not a client's) — used only
# to send the one-time welcome SMS right after a client completes
# onboarding. See src/lib/notifications.ts (sendWelcomeSms).
# Used for AIRTEL/GLO/MOBILE9, and as the MTN fallback if the var below
# isn't set.
MESAJ_WELCOME_SENDER_ID=

# MTN-specific override — MTN can (and here, does) approve a different
# exact shortCode string than the other carriers for the same brand.
# Optional: falls back to MESAJ_WELCOME_SENDER_ID above if unset.
MESAJ_WELCOME_SENDER_ID_MTN=
# Shared secret for verifying inbound Mesaj delivery-report webhooks.
# CONFIRM THE EXACT SCHEME WITH MESAJ — this is a placeholder header-based
# check (see src/app/api/mesaj/webhook/route.ts) until they confirm how
# they actually sign/authenticate webhook calls.
MESAJ_WEBHOOK_SECRET=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Email (transactional)
RESEND_API_KEY=
EMAIL_FROM=noreply@mesajsme.com
# Comma-separated — who gets emailed on a new signup or new Sender ID
# request (see lib/notifications.ts notifyAdminNewSignup /
# notifyAdminNewSenderIdRequest). No spaces needed around commas, but
# trimmed either way.
ADMIN_NOTIFICATION_EMAILS=femi@venixpartners.com,dsking32@gmail.com

# Error monitoring (Sentry)
# Deliberately left blank here, even though the real values aren't
# secret (a DSN is meant to be public) — this file is the TEMPLATE for
# any environment built from this repo (a new contributor's local setup,
# a future staging environment, etc.), and leaving these blank forces
# each environment to explicitly set its own, rather than silently
# defaulting to this one company's production Sentry project. The real
# values live in .env.local (gitignored, not this file) and in Vercel's
# environment variables.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
